# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Rider (JetBrains IDE) 설정 폴더
.idea/
# macOS Finder 생성 파일
.DS_Store

# 성능 측정 결과 (스냅샷·프로파일 기록이라 용량이 크다)
/PerfResults/

# ---------------------------------------------------------------
# 2.5DProject 추가 규칙
# ---------------------------------------------------------------

# 서버(.NET) 솔루션/프로젝트는 직접 관리하므로 커밋한다 (위의 *.sln, *.csproj 무시를 되돌림)
!/Server/*.sln
!/Server/**/*.csproj
!/Server/**/*.props

# 서버 빌드 산출물
/Server/**/bin/
/Server/**/obj/
/Server/**/TestResults/

# 사용자가 받은 외부 에셋 원본 zip 보관 폴더
/_AssetSource/

# 재배포가 허용되지 않는 외부 에셋 (Docs/Credits.md 의 링크에서 직접 받아 넣는다)
/Assets/90.ExternalAssets/Environment/WizP_StylizedAsianVillage/
/Assets/90.ExternalAssets/Environment/WizP_StylizedAsianVillage.meta
/Assets/90.ExternalAssets/SFX/Leohpaz_RPGEssentialsSFX/
/Assets/90.ExternalAssets/SFX/Leohpaz_RPGEssentialsSFX.meta
# 라이선스 확인 전까지 제외 (재배포 허용이 확인되면 아래 줄을 지운다)
/Assets/90.ExternalAssets/Characters/SmallScale_TopDownKnight/
/Assets/90.ExternalAssets/Characters/SmallScale_TopDownKnight.meta
/Assets/90.ExternalAssets/Environment/ElyDev_MiniJapan/
/Assets/90.ExternalAssets/Environment/ElyDev_MiniJapan.meta
/Assets/90.ExternalAssets/UI/Soiam_PixelUIMobile/
/Assets/90.ExternalAssets/UI/Soiam_PixelUIMobile.meta
/Assets/90.ExternalAssets/UI/ELV_FreeInventory/
/Assets/90.ExternalAssets/UI/ELV_FreeInventory.meta
# 재배포 금지 (SovDigital: 단독 에셋 공유 금지 / Eris Esra: 에셋 팩 형태 사용 금지)
/Assets/90.ExternalAssets/Monsters/SovDigital_Skeleton/
/Assets/90.ExternalAssets/Monsters/SovDigital_Skeleton.meta
/Assets/90.ExternalAssets/Monsters/SovDigital_Wolf/
/Assets/90.ExternalAssets/Monsters/SovDigital_Wolf.meta
/Assets/90.ExternalAssets/Characters/ErisEsra_CharacterTemplate/
/Assets/90.ExternalAssets/Characters/ErisEsra_CharacterTemplate.meta
